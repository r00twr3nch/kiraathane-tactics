{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=kiraathane-dev.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/kiraathane-.log", "rollingInterval": "Day" }
      }
    ]
  }
}
